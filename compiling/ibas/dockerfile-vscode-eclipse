# 基于镜像ubuntu
FROM colorcoding/webtop:ubuntu

# 维护者
LABEL maintainer="Niuren.Zhu <niuren.zhu@icloud.com>"

USER root

RUN set -x \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    unzip zip dos2unix git nodejs npm \
    # vscode依赖,tfs依赖
    libsecret-1-0 libnss3 gnupg libxss1 libxtst6 libkrb5-dev \
    libgl1 libgbm1 dbus-x11 \
    && rm -rf /var/lib/apt/lists/*

# jdk8
ARG JAVA_BINARY_URL='https://github.com/ibmruntimes/semeru8-binaries/releases/download/jdk-8.0.502.0/ibm-semeru-open-jdk_x64_linux_8.0.502.0.tar.gz'
RUN set -x \
    && curl -LfsSo /tmp/openjdk.tar.gz ${JAVA_BINARY_URL} \
    && curl -LfsSo /tmp/openjdk.tar.gz.sha256 "${JAVA_BINARY_URL}.sha256.txt" \
    && echo "$(awk '{print $1}' /tmp/openjdk.tar.gz.sha256) */tmp/openjdk.tar.gz" | sha256sum -c - \
    && mkdir -p /opt/java/openjdk && mkdir -p /opt/java/.scc \
    && cd /opt/java/openjdk \
    && tar -xf /tmp/openjdk.tar.gz --strip-components=1 \
    && rm -rf /tmp/openjdk.tar.gz /tmp/openjdk.tar.gz.sha256
ENV JAVA_HOME=/opt/java/openjdk \
    PATH="/opt/java/openjdk/bin:$PATH"

# maven
ARG MAVEN_SHA=831a8591fe20c8243b1dbe7d71e3244f31d1665b0804b2e825e38cbbe5ce0cafb8338851f90780735568773e0a6cd07bbec107cda0b896b008b861075358b6f6
ARG MAVEN_BINARY_URL=https://archive.apache.org/dist/maven/maven-3/3.9.16/binaries/apache-maven-3.9.16-bin.tar.gz
RUN set -x \
    && mkdir -p /usr/share/maven \
    && curl -fsSL -o /tmp/apache-maven.tar.gz ${MAVEN_BINARY_URL} \
    && echo "${MAVEN_SHA}  /tmp/apache-maven.tar.gz" | sha512sum -c - \
    && tar -xzf /tmp/apache-maven.tar.gz -C /usr/share/maven --strip-components=1 \
    && rm -f /tmp/apache-maven.tar.gz \
    && ln -s /usr/share/maven/bin/mvn /usr/bin/mvn
ENV MAVEN_HOME /usr/share/maven
RUN awk '/<mirror[[:space:]>]/ { in_mirror=1; mirror="" } in_mirror { mirror=mirror $0 ORS; if (/<\/mirror>/) { if (mirror !~ /<id>[[:space:]]*maven-default-http-blocker[[:space:]]*<\/id>/) printf "%s", mirror; in_mirror=0; mirror="" } next } { print }' ${MAVEN_HOME}/conf/settings.xml > /tmp/settings.xml \
    && cat /tmp/settings.xml > ${MAVEN_HOME}/conf/settings.xml \
    && rm -f /tmp/settings.xml

# typescript
RUN set -x \
    && npm install -g --no-audit --no-fund typescript@3.9.10 uglify-es \
    && npm cache clean --force \
    && rm -rf /root/.npm

# vscode
RUN curl -LfsSo /tmp/vscode_amd64.deb 'https://update.code.visualstudio.com/1.48.2/linux-deb-x64/stable' \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y /tmp/vscode_amd64.deb \
    && rm -f /tmp/vscode_amd64.deb \
    && rm -rf /var/lib/apt/lists/*

RUN printf '%s\n' \
    '[Desktop Entry]' \
    'Name=Visual Studio Code' \
    'Comment=Code Editing. Redefined.' \
    'Exec=/usr/share/code/code --no-sandbox --disable-gpu --user-data-dir=/home/headless/.config/Code --unity-launch %F' \
    'Icon=com.visualstudio.code' \
    'Type=Application' \
    'Terminal=false' \
    'StartupNotify=false' \
    'StartupWMClass=Code' \
    'Categories=Development;IDE;' \
    > /usr/share/applications/code.desktop

# vscode 命令行入口：显式使用当前用户的配置目录
RUN printf '%s\n' \
    '#!/bin/sh' \
    'exec /usr/bin/code --user-data-dir="${HOME}/.config/Code" --no-sandbox --disable-gpu "$@"' \
    > /usr/local/bin/code \
    && chmod 755 /usr/local/bin/code

# eclipse jee
RUN curl -LfsSo /tmp/eclipse.tar.gz 'https://www.eclipse.org/downloads/download.php?file=/technology/epp/downloads/release/2020-06/R/eclipse-jee-2020-06-R-linux-gtk-x86_64.tar.gz' \
    && mkdir -p /usr/share/eclipse \
    && cd /usr/share/eclipse \
    && tar -xf /tmp/eclipse.tar.gz --strip-components=1 \
    && rm -f /tmp/eclipse.tar.gz

RUN printf '%s\n' \
    '[Desktop Entry]' \
    'Name=Eclipse' \
    'Comment=Eclipse' \
    'Exec=/usr/share/eclipse/eclipse' \
    'Icon=/usr/share/eclipse/icon.xpm' \
    'Terminal=false' \
    'Type=Application' \
    'Categories=Development;IDE;' \
    'StartupNotify=false' \
    > /usr/share/applications/eclipse.desktop

# tfs plugin
ARG TEE_VERSION=14.139.0
RUN \
    # plugin
    curl -LfsSo /tmp/TFSEclipsePlugin.zip https://github.com/microsoft/team-explorer-everywhere/releases/download/${TEE_VERSION}/TFSEclipsePlugin-UpdateSiteArchive-${TEE_VERSION}.zip \
    && unzip -o /tmp/TFSEclipsePlugin.zip -d /tmp/TFSEclipsePlugin \
    && mv /tmp/TFSEclipsePlugin/features/*.jar /usr/share/eclipse/features/ \
    && mv /tmp/TFSEclipsePlugin/plugins/*.jar /usr/share/eclipse/plugins/ \
    && rm -rf /tmp/TFSEclipsePlugin.zip /tmp/TFSEclipsePlugin \
    # tools
    && curl -LfsSo /tmp/TEE-CLC.zip https://github.com/microsoft/team-explorer-everywhere/releases/download/${TEE_VERSION}/TEE-CLC-${TEE_VERSION}.zip \
    && unzip -o /tmp/TEE-CLC.zip -d /usr/share/ \
    && ln -s /usr/share/TEE-CLC-${TEE_VERSION}/tf /usr/bin/tf \
    && rm -rf /tmp/TEE-CLC.zip
ENV TF_CLC_HOME /usr/share/TEE-CLC-${TEE_VERSION}/

# user setting
RUN \
    mkdir -p ${HOME}/.config/Code/User/ \
        ${HOME}/.cache ${HOME}/.local ${HOME}/.npm \
    && echo '{"update.mode": "none"}' >${HOME}/.config/Code/User/settings.json \
    && chown -R "${HEADLESS_USER_ID}:${HEADLESS_USER_GROUP_ID}" \
        ${HOME}/.config/Code ${HOME}/.cache ${HOME}/.local ${HOME}/.npm \
    && "${STARTUPDIR}"/set_user_permissions.sh "${HOME}"

USER "${HEADLESS_USER_ID}"
